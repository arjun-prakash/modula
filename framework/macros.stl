\RequirePackage{cleveref}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 1) Productivity / author note commands
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\amy}[1]{{\color{red}[\textsc{Amy}: \emph{#1}]}}
\newcommand{\samy}[2]{{\color{orange}\sout{#1}\color{orange}#2}}

\newcommand{\arjun}[1]{{\color{blue}[\textsc{Arjun}: \emph{#1}]}}
\newcommand{\sarjun}[2]{{\color{blue}\sout{#1}\color{blue}#2}}
\newcommand{\enr}[1]{{\color{orange}[\textsc{Enrique}: \emph{#1}]}}
\newcommand{\senr}[2]{{\color{orange}\sout{#1}\color{orange}#2}}
\newcommand{\sadie}[1]{{\color{magenta}[\textsc{Sadie}: \emph{#1}]}}
\newcommand{\ssadie}[2]{{\color{magenta}\sout{#1}\color{magenta}#2}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 2) Spaces / sets / basic objects (ML + optimization notation)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\vecspace}[1][]{\calV}
\newcommand{\dualspace}[1][]{\calV^{*}}
\newcommand{\weightspace}[1][]{\calW^{*}}

\newcommand{\tasknum}[1][]{\tau_{#1}}
\newcommand{\outertasknum}[1][]{\bm{\phi}_{\tau}}

\newcommand{\constr}[1][]{\iota_{\calC}}
\newcommand{\constrSet}[1][]{\calC}
\newcommand{\simplex}[1][]{\Delta}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 3) Main Optimization Notation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\msign}[1][]{\text{msign}(#1)}
\newcommand{\holderexp}[1][]{\alpha_{#1}}
\newcommand{\transpose}[1]{{#1}^{\top}}

\newcommand{\grad}[1][]{\nabla_{#1}}
\newcommand{\subgrad}[1][]{s_{#1}}

\newcommand{\gr}[1][]{\bm{g}_{#1}}


\DeclareDocumentCommand{\weights}{ O{} O{} o o }{%
  \bm{w}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

% Important matrix notation

\DeclareDocumentCommand{\Weights}{ O{} O{} o o }{%
  \bm{W}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}
\DeclareDocumentCommand{\Gr}{ O{} O{} o o }{%
  \bm{G}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}
\DeclareDocumentCommand{\Momentum}{ O{} O{} o o }{%
  \bm{M}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}
\DeclareDocumentCommand{\Orthogonal}{ O{} O{} o o }{%
  \bm{O}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}
\DeclareDocumentCommand{\Tangent}{ O{} O{} o o }{%
  \bm{A}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

% ADMM specific subproblem notation

\DeclareDocumentCommand{\MSubproblem}{ O{} O{} o o }{%
  \bm{M}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\XSubproblem}{ O{} O{} o o }{%
  \bm{X}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\OmSubproblem}{ O{} O{} o o }{%
  \ensuremath{\Omega_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }}%
}

\newcommand{\direction}[1][]{\bm{t}_{#1}}
\newcommand{\Expect}[0]{\mathbb{E}}

\DeclareMathOperator\supp{supp}
\DeclareMathOperator\prox{prox}
\DeclareMathOperator\softmax{softmax}
\DeclareMathOperator\dualize{dualize_{\Vert\cdot\Vert}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 4) Norms
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareDocumentCommand{\norm}{ o }{%
  \lVert #1\rVert%
}

\DeclareDocumentCommand{\dualnorm}{ o }{%
  \lVert #1\rVert^{\dagger}%
}

\DeclareDocumentCommand{\frobeniusnorm}{ o }{%
  \lVert #1\rVert_{F}%
}

\newcommand{\snorm}[1]{\lVert {#1} \rVert_2}
\newcommand{\rmsnorm}[1]{\lVert {#1} \rVert_{\text{RMS}}}
\newcommand{\rmsrmsnorm}[1]{\lVert {#1} \rVert_{\text{RMS} \rightarrow \text{RMS}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 5) Divergences / regularizers / dual variables / deltas
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\diverg}[1][]{\D_{\psi}}
\newcommand{\distgen}[1][]{\psi^{#1}}
\newcommand{\reg}[1][]{R_{#1}}
\newcommand{\dualvar}[1][]{\Lambda_{#1}}

\newcommand{\change}[1][]{\Delta^{#1}}
\newcommand{\major}[1][]{\lambda^{#1}}
\newcommand{\sharpparam}[1][]{\lambda_{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 6) Iteration / indexing counts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\numiters}[1][]{K_{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 8) Deep network / architecture / losses / activation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\deepnet}[1][]{f_{#1}}

\newcommand{\layer}[1][]{l_{#1}}
\newcommand{\numlayers}[1][]{L_{#1}}
\newcommand{\layerdim}[1][]{M_{#1}}

\newcommand{\inputdim}[1][]{d}
\newcommand{\outputdim}[1][]{K}

\newcommand{\lossfunc}[1][]{\calL_{#1}}
\newcommand{\batchloss}[1][]{\ell_{#1}}

\newcommand{\nonlin}[1][]{\sigma^{#1}}
\newcommand{\relu}[1][]{ReLU }

\newcommand{\firstlip}[1][]{\alpha}
\newcommand{\secondlip}[1][]{\beta}

\newcommand{\margin}[1][]{\gamma_{#1}}
\newcommand{\radius}[1][]{r_{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 9) Parameters / data / tensors (structured xparse macros)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareDocumentCommand{\bias}{ O{} O{} o o }{%
  \mathbf{b}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\params}{ O{} O{} o o }{%
  \bm{\theta}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\inner}{ O{} O{} o }{%
  \bm{\theta}_{#1}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\outer}{ O{} O{} o }{%
  \bm{\phi}_{#1}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\datax}{ O{} O{} o }{%
  \bm{x}_{#1}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\datay}{ O{} O{} o }{%
  \bm{y}_{#1}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\datadist}{ O{} O{} o }{%
  \bm{p}_{#1}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 10) Linear algebra / derivatives of maps
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareDocumentCommand{\Hessian}{ O{} O{} o o }{%
  \mathbf{H}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\Jacobian}{ O{} O{} o o }{%
  \mathbf{}{J}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\DeclareDocumentCommand{\eigenvec}{ O{} O{} o o }{%
  \mathbf{v}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

\newcommand{\eigenval}[1][]{\sigma_{#1}}

\DeclareDocumentCommand{\eigenval}{ O{} O{} o o }{%
  \bm{\lambda}_{#1%
    \IfValueTF{#4}{\lbrack #4\rbrack}%
  {}}^{#2%
    \IfValueTF{#3}{(#3)}{}%
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 11) Theorem-like environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newtheorem{theorem}{Theorem}[section]
\newtheorem{claim}[theorem]{Claim}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem{fact}[theorem]{Fact}
\newtheorem{example}[theorem]{Example}
\newtheorem{notation}[theorem]{Notation}
\newtheorem{observation}[theorem]{Observation}
\newtheorem{conjecture}[theorem]{Conjecture}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 12) Probability / expectation / moments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Probability/expectation operators.  The ones ending in x should be used if you want
% subscripts that go directly *below* the operator (in math mode); no x means the subscripts
\renewcommand{\Pr}{{\bf Pr}}
\newcommand{\Prx}{\mathop{\bf Pr\/}}
\newcommand{\E}{{\bf E}}

\newcommand{\Var}{{\bf Var}}
\newcommand{\Varx}{\mathop{\bf Var\/}}
\newcommand{\Cov}{{\bf Cov}}
\newcommand{\Covx}{\mathop{\bf Cov\/}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 13) Shortcuts / accents / delimiters
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% shortcuts for symbol names that are too long to type
\newcommand{\la}{\langle}
\newcommand{\ra}{\rangle}
\newcommand{\wh}{\widehat}
\newcommand{\wt}{\widetilde}

