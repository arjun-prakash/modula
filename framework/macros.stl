%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 23) Appendix tool
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Appendix tool

\newif\ifappendix
\NewEnviron{maybeappendix}[1]
    {\ifappendix
        \expandafter\global\expandafter\let\csname putmaybeappendix#1\endcsname\BODY%
    \else
        \expandafter\newcommand\csname putmaybeappendix#1\endcsname{}\BODY%
    \fi}
\newcommand{\putmaybeappendix}[1]{\csname putmaybeappendix#1\endcsname}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 24) Widebar / accents helper
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*\rel@kern[1]{\kern#1\dimexpr\macc@kerna}
\newcommand*\widebar[1]{%
  \begingroup
  \def\mathaccent##1##2{%
    \rel@kern{0.8}%
    \overline{\rel@kern{-0.8}\macc@nucleus\rel@kern{0.2}}%
    \rel@kern{-0.2}%
  }%
  \macc@depth\@ne
  \let\math@bgroup\@empty \let\math@egroup\macc@set@skewchar
  \mathsurround\z@ \frozen@everymath{\mathgroup\macc@group\relax}%
  \macc@set@skewchar\relax
  \let\mathaccentV\macc@nested@a
  \macc@nested@a\relax111{#1}%
  \endgroup
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 25) Fan-in / fan-out (init / architecture scalars)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\fanin}[0]{\text{fan-in}}
\newcommand{\fanout}[0]{\text{fan-out}}

% Cref settings
\newcommand{\probref}[1]{\hyperref[#1]{Problem~(\ref*{#1})}}
\newcommand{\ruleref}[1]{\hyperref[#1]{Update rule~(\ref*{#1})}}
